#!/usr/bin/env bash
# Geriye dönük uyumluluk sarmalayıcısı (v0.1 waybar-ai-quota -> v0.2 agent-notifier)
set -euo pipefail
SOURCE="${BASH_SOURCE[0]}"
while [[ -L "$SOURCE" ]]; do
    SOURCE_DIR="$(cd -P -- "$(dirname -- "$SOURCE")" && pwd)"
    SOURCE="$(readlink -- "$SOURCE")"
    [[ "$SOURCE" == /* ]] || SOURCE="$SOURCE_DIR/$SOURCE"
done
SCRIPT_DIR="$(cd -P -- "$(dirname -- "$SOURCE")" && pwd)"
if [[ $# -eq 0 ]]; then
    exec "$SCRIPT_DIR/agent-notifier" dashboard --toggle
fi
exec "$SCRIPT_DIR/agent-notifier" "$@"
